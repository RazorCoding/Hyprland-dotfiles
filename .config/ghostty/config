# -------- GENERAL --------
#theme = "Banana Blueberry"
theme = "Monokai Soda"
#theme = "Abernathy"
#theme = "Clu"
background-opacity = 0.90
window-decoration = false
window-padding-x = 10
window-padding-y = 10
background-blur = true
background-image = /home/Gnana/.config/waybar/scripts/ghostty-bg.png
background-image-fit = cover
background-image-opacity = 0.10
background-image-position = center

#font-feature = -liga, -dlig, -calt
# -------- COLORS --------
background = #000000
foreground = #d4d4d4


# If you still want Monokai-like accents, you can add these (optional)
selection-background = #49483e
selection-foreground = #f8f8f2

# -------- FONT --------
font-family = "Iosevka SS18"
font-size = 19.5
adjust-cell-width = 0
font-style = regular
font-style-bold = regular
font-style-italic = italic
font-style-bold-italic = bold italic
font-feature = -feat, -liga, -calt 

cursor-color = #ffffff
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

notify-on-command-finish = always
notify-on-command-finish-action = notify
notify-on-command-finish-after = 5s
