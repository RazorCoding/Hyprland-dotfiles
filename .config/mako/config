# Global Options
font=IosevkaSS17 18
background-color=#1e1e1e
text-color=#d4d4d4
border-color=#9c9a9a
border-size=0
border-radius=3
width=500
height=200
margin=7
padding=10
icon-path=/usr/share/icons/Papirus-Dark
max-icon-size=74
markup=1
actions=1
history=1
max-history=10
sort=-time
default-timeout=10000

# High urgency/critical alerts stay forever until clicked (0 disables the timeout)
[urgency=high]
default-timeout=0

