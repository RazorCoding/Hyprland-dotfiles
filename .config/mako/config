# Global Options
font=Iosevka SS18 18
background-color=#1e1e1e
text-color=#d4d4d4
border-color=#5e5e5e
border-size=1
border-radius=3
anchor=top-right
width=500
height=200
margin=7
padding=10
icon-path=/usr/share/icons/Papirus-Dark
max-icon-size=74
markup=1
actions=1
history=1
max-history=10
sort=-time
default-timeout=10000




# High urgency/critical alerts stay forever until clicked (0 disables the timeout)
[urgency=high]
default-timeout=0

# Media-title notifications from youtube-media-notify.sh send no icon of their
# own, so mako would fall back to the sending app's icon. Suppress it here
# rather than globally, so other notifications keep their icons.
[app-name=YouTube]
icons=0

